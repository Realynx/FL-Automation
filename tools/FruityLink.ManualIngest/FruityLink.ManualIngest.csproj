<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0 (not -windows): this is a cross-platform offline data-prep tool and it
         references the net9.0 Core/Knowledge/Llm libraries. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>manualingest</AssemblyName>
    <RootNamespace>FruityLink.ManualIngest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FruityLink.Core\FruityLink.Core.csproj" />
    <ProjectReference Include="..\..\src\FruityLink.Knowledge\FruityLink.Knowledge.csproj" />
    <ProjectReference Include="..\..\src\FruityLink.Llm\FruityLink.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="ReverseMarkdown" />
  </ItemGroup>
</Project>
