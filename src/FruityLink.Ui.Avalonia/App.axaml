<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FruityLink.Ui.Avalonia.App"
             RequestedThemeVariant="Dark">
    <!-- The interior UI is dark-first (marketing hero). We pin Dark so the FluentTheme
         base controls (scrollbars, text selection, focus adorners) render on the dark ramp. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design tokens: colours, brand/headline gradients, aurora glows, fonts. -->
                <ResourceInclude Source="avares://FruityLink.Ui.Avalonia/Theme/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Our hero-themed control styles layered on top of Fluent. -->
        <StyleInclude Source="avares://FruityLink.Ui.Avalonia/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
