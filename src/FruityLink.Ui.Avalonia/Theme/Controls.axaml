<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FruityLink.Ui.Avalonia.Theme"
        x:Class="FruityLink.Ui.Avalonia.Theme.ProductStyles">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:ProductTokens />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <!-- ============================================================================
         Hero-themed control styles, layered on top of FluentTheme (dark).
         Everything keys off Theme/Tokens.axaml. Class-based selectors keep these opt-in
         so we don't fight Fluent's defaults for controls we don't touch.
         ============================================================================ -->

    <!-- =============================== Typography =============================== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.6" /> <!-- ≈ -0.02em @ 32px -->
        <Setter Property="Foreground" Value="{StaticResource HeadlineGradientBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Branded wordmark / focal headline (headline gradient clipped to glyphs). -->
    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.2" />
        <Setter Property="Foreground" Value="{StaticResource HeadlineGradientBrush}" />
    </Style>

    <Style Selector="TextBlock.h">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.36" />
        <Setter Property="Foreground" Value="{StaticResource HeadingTextBrush}" />
    </Style>

    <!-- :is(TextBlock) so these also hit SelectableTextBlock (transcript text is selectable/copyable;
         Avalonia selectors match the exact type unless :is() is used). -->
    <Style Selector=":is(TextBlock).body">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- Assistant reply text: full-strength near-white (StrongText #eceef6). The reply is the main
         thing the producer reads — it gets the brightest body tier, on the opaque reply card. -->
    <Style Selector=":is(TextBlock).body.asst">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>

    <!-- Failed turn: soft red (matches the WPF chat's error colour). Declared AFTER .asst so error
         red wins on assistant text. -->
    <Style Selector=":is(TextBlock).body.error">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- Brand-violet selection highlight for the selectable transcript text. -->
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="#668b5cf6" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.meta">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource MetaTextBrush}" />
    </Style>

    <!-- Assistant author label ("FL Automate" on each reply) — brighter than meta (the old MetaText
         Ink300 read as washed-out) and display-face so it echoes the wordmark. -->
    <Style Selector="TextBlock.author">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>

    <!-- Tiny per-message timestamp — quietest text on the surface, deliberately unobtrusive. -->
    <Style Selector="TextBlock.timestamp">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource MetaTextBrush}" />
    </Style>

    <!-- Settings row: a bright label + a dimmer (but legible) description. -->
    <Style Selector="TextBlock.settingLabel">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settingDesc">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- Badge: 12px, tracking +0.1em, accent-tinted. -->
    <Style Selector="TextBlock.badge">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{StaticResource Accent300Brush}" />
    </Style>

    <!-- Monospace tool-call lines. -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Accent200Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Streamed reasoning ("thoughts") — dim italic, accent-tinted. -->
    <Style Selector="TextBlock.thought">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource Accent300Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- =============================== Surfaces ================================ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{StaticResource Glass05Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ============================= Chat bubbles ============================= -->
    <!-- User: brand gradient, right-aligned, soft violet glow. -->
    <Style Selector="Border.userBubble">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="CornerRadius" Value="14,14,4,14" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MaxWidth" Value="440" />
        <Setter Property="Margin" Value="48,4,0,4" />
        <Setter Property="BoxShadow" Value="0 8 26 -12 #997C3AED" />
    </Style>

    <!-- Assistant: OPAQUE reply card, left-aligned. Was 5% glass — the aurora glow bled through
         behind the reply text and it read as translucent (user feedback). The opaque fill +
         soft drop shadow makes the reply the most legible surface in the transcript. -->
    <Style Selector="Border.asstBubble">
        <Setter Property="Background" Value="{StaticResource AsstBubbleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14,14,14,4" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="Margin" Value="0,4,48,4" />
        <Setter Property="BoxShadow" Value="0 6 18 -8 #99000000" />
    </Style>

    <!-- Info / system line: quiet, centered-ish, no strong fill. -->
    <Style Selector="Border.infoBubble">
        <Setter Property="Background" Value="{StaticResource Glass04Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Margin" Value="0,4,48,4" />
    </Style>

    <!-- Tool-call chip. -->
    <Style Selector="Border.toolChip">
        <Setter Property="Background" Value="{StaticResource AccentChipFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <!-- =============================== Buttons ================================ -->
    <!-- Shared button chrome: pill, medium Inter, animated hover-lift. -->
    <Style Selector="Button.pill">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.pill:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="Button.pill:pressed">
        <Setter Property="RenderTransform" Value="translateY(0)" />
    </Style>

    <!-- Link: borderless accent text that behaves like a hyperlink (opens external pages). -->
    <Style Selector="Button.link">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Accent300Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Accent200Brush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Accent400Brush}" />
    </Style>

    <!-- Primary: brand gradient + violet glow (kept across all interaction states). -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="BoxShadow" Value="0 10 40 -12 #CC7C3AED" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="BoxShadow" Value="0 14 46 -10 #E67C3AED" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="BoxShadow" Value="0 8 30 -14 #CC7C3AED" />
    </Style>

    <!-- Danger (Cancel state of Send): magenta gradient + magenta glow. -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,36%">
                <GradientStop Color="#e879f9" Offset="0.0" />
                <GradientStop Color="#d946ef" Offset="1.0" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BoxShadow" Value="0 10 40 -12 #CCD946EF" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 14 46 -10 #E6D946EF" />
    </Style>

    <!-- Secondary: glass. -->
    <Style Selector="Button.secondary">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass04Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
    </Style>

    <!-- Round icon button (mic). -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass05Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Force the glyph to sit dead-centre: the Fluent Button ContentPresenter otherwise inherits
             an asymmetric default Padding that nudges the icon to the right. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
    </Style>
    <!-- Mic active (recording): magenta fill. -->
    <Style Selector="Button.icon.recording /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Magenta500Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Magenta400Brush}" />
    </Style>
    <Style Selector="Button.icon.recording">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Tiny inline icon button (per-message copy). Invisible chrome until hovered so it never
         competes with the reply text. -->
    <Style Selector="Button.miniIcon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.miniIcon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.miniIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
    </Style>
    <Style Selector="Button.miniIcon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>

    <!-- Floating "jump to latest" pill over the transcript (shown when the user scrolls up). Opaque
         surface + violet-tinted shadow so it reads above the aurora. -->
    <Style Selector="Button.jump">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.jump /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BoxShadow" Value="0 8 24 -8 #CC7C3AED" />
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Ink700}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>

    <!-- Suggestion chip (empty-state quick prompts): pill glass that lights brand on hover. -->
    <Style Selector="Button.suggestion">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.suggestion /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass04Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9999" />
    </Style>
    <Style Selector="Button.suggestion:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>
    <Style Selector="Button.suggestion:pointerover">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>

    <!-- =============================== Composer =============================== -->
    <Style Selector="TextBox.composer">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent300Brush}" />
        <Setter Property="SelectionBrush" Value="#668b5cf6" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MaxHeight" Value="160" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
    </Style>
    <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>

    <!-- ========================= Settings form fields ========================= -->
    <!-- Single-line text field for the AI-connection card (endpoint / model / key / deployment). Same
         glass chrome as the composer but compact, single-line, and with a brand-lit focus border. -->
    <Style Selector="TextBox.field">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent300Brush}" />
        <Setter Property="SelectionBrush" Value="#668b5cf6" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>

    <!-- Provider dropdown for the AI-connection card. -->
    <Style Selector="ComboBox.field">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.field /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ComboBox.field:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
    </Style>

    <!-- =============================== Toggles ================================ -->
    <Style Selector="CheckBox.toggle">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
    <!-- Brand-tint the checked box (Fluent's default accent is a blue that clashes). -->
    <Style Selector="CheckBox.toggle:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>

    <!-- Small status dot (Listening indicator). -->
    <Style Selector="Border.statusDot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Background" Value="{StaticResource Accent400Brush}" />
    </Style>

</Styles>
