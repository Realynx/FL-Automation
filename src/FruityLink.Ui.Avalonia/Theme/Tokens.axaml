<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================================
         FL Automate — design tokens for the interior UI.
         Single source of truth, mirrored from docs/ui-design-tokens.md (extracted from
         the marketing hero). When the hero theme changes, update BOTH files.

         Only rock-solid resource types live here (Color / SolidColorBrush / gradient
         brushes / FontFamily). Radii and the type scale are applied in Theme/Controls.axaml
         and the views, with the token value called out in a comment at each use site.
         ============================================================================ -->

    <!-- ============================== Palette (raw colours) ====================== -->
    <!-- Brand — electric violet -->
    <Color x:Key="Brand50">#f4f2ff</Color>
    <Color x:Key="Brand100">#ece7ff</Color>
    <Color x:Key="Brand200">#d8ccff</Color>
    <Color x:Key="Brand300">#bca5ff</Color>
    <Color x:Key="Brand400">#9d74ff</Color>
    <Color x:Key="Brand500">#8b5cf6</Color>
    <Color x:Key="Brand600">#7c3aed</Color>
    <Color x:Key="Brand700">#6d28d9</Color>
    <Color x:Key="Brand800">#581c9e</Color>
    <Color x:Key="Brand900">#481a85</Color>
    <Color x:Key="Brand950">#2c0f5e</Color>

    <!-- Accent — signal cyan -->
    <Color x:Key="Accent200">#a5f3fc</Color>
    <Color x:Key="Accent300">#67e8f9</Color>
    <Color x:Key="Accent400">#22d3ee</Color>
    <Color x:Key="Accent500">#06b6d4</Color>
    <Color x:Key="Accent600">#0891b2</Color>

    <!-- Magenta / fuchsia (gradient mid) -->
    <Color x:Key="Magenta400">#e879f9</Color>
    <Color x:Key="Magenta500">#d946ef</Color>

    <!-- Ink — dark surfaces / text -->
    <Color x:Key="Ink50">#eceef6</Color>
    <Color x:Key="Ink100">#cdcfdd</Color>
    <Color x:Key="Ink200">#a6a8c0</Color>
    <Color x:Key="Ink300">#8a8caa</Color>
    <Color x:Key="Ink400">#777a9e</Color>
    <Color x:Key="Ink500">#323247</Color>
    <Color x:Key="Ink600">#232333</Color>
    <Color x:Key="Ink700">#191925</Color>
    <Color x:Key="Ink800">#111119</Color>
    <Color x:Key="Ink900">#0b0b12</Color>
    <Color x:Key="Ink950">#06060c</Color>

    <!-- ============================== Solid brushes ============================= -->
    <!-- Brand ramp -->
    <SolidColorBrush x:Key="Brand300Brush" Color="{StaticResource Brand300}" />
    <SolidColorBrush x:Key="Brand400Brush" Color="{StaticResource Brand400}" />
    <SolidColorBrush x:Key="Brand500Brush" Color="{StaticResource Brand500}" />
    <SolidColorBrush x:Key="Brand600Brush" Color="{StaticResource Brand600}" />

    <!-- Accent ramp -->
    <SolidColorBrush x:Key="Accent200Brush" Color="{StaticResource Accent200}" />
    <SolidColorBrush x:Key="Accent300Brush" Color="{StaticResource Accent300}" />
    <SolidColorBrush x:Key="Accent400Brush" Color="{StaticResource Accent400}" />

    <SolidColorBrush x:Key="Magenta400Brush" Color="{StaticResource Magenta400}" />
    <SolidColorBrush x:Key="Magenta500Brush" Color="{StaticResource Magenta500}" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="{StaticResource Ink950}" />          <!-- app base bg -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Ink900}" />                 <!-- elevated panels -->
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{StaticResource Ink800}" />
    <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="#99000000" />                    <!-- deep well behind glass -->

    <!-- Assistant reply card: FULLY OPAQUE (between Ink800/Ink700) so the aurora glow can never
         bleed through behind reply text (user feedback: replies read as translucent / hard to read
         on the 5% glass fill). The hero's white/4-over-dark look is baked into the flat colour. -->
    <SolidColorBrush x:Key="AsstBubbleBrush" Color="#15151F" />

    <!-- Text ramp. Primary/body text is kept bright + fully opaque for readability on the dark base
         (user feedback: earlier body text read as too translucent). Muted/meta stay dimmer but legible. -->
    <SolidColorBrush x:Key="HeadingTextBrush" Color="White" />
    <SolidColorBrush x:Key="StrongTextBrush" Color="{StaticResource Ink50}" />   <!-- #eceef6 -->
    <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource Ink100}" />    <!-- #cdcfdd (was Ink200) -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Ink200}" />   <!-- #a6a8c0 (was Ink300) -->
    <SolidColorBrush x:Key="MetaTextBrush" Color="{StaticResource Ink300}" />    <!-- #8a8caa (was Ink400) -->


    <!-- Glass + hairline borders (white/N over dark). -->
    <SolidColorBrush x:Key="Glass04Brush" Color="#0AFFFFFF" />   <!-- white/4  secondary button fill -->
    <SolidColorBrush x:Key="Glass05Brush" Color="#0DFFFFFF" />   <!-- white/5  glass fill -->
    <SolidColorBrush x:Key="Glass08Brush" Color="#14FFFFFF" />   <!-- white/8  glass hover -->
    <SolidColorBrush x:Key="BorderWhite10Brush" Color="#1AFFFFFF" />  <!-- white/10 default hairline -->
    <SolidColorBrush x:Key="BorderWhite20Brush" Color="#33FFFFFF" />  <!-- white/20 hover hairline -->
    <SolidColorBrush x:Key="BorderInkBrush" Color="{StaticResource Ink600}" /> <!-- #232333 default border -->

    <!-- Accent chip (tool-call pills): accent-400 @ ~10% fill, @ ~20% border. -->
    <SolidColorBrush x:Key="AccentChipFillBrush" Color="#1A22D3EE" />
    <SolidColorBrush x:Key="AccentChipBorderBrush" Color="#3322D3EE" />

    <!-- Error / warning (matches the WPF chat's soft red). -->
    <SolidColorBrush x:Key="DangerBrush" Color="#f28b82" />

    <!-- ============================== Gradients ================================= -->
    <!-- Brand gradient (buttons, user bubbles, UI accents): css linear-gradient(110deg,...).
         110deg ≈ start top-left → end bottom-right, shallow (mostly horizontal). -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,36%">
        <GradientStop Color="{StaticResource Brand500}" Offset="0.0" />
        <GradientStop Color="{StaticResource Brand600}" Offset="0.42" />
        <GradientStop Color="{StaticResource Magenta500}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Headline text-gradient (clipped to text via TextBlock.Foreground). -->
    <LinearGradientBrush x:Key="HeadlineGradientBrush" StartPoint="0%,0%" EndPoint="100%,25%">
        <GradientStop Color="{StaticResource Brand300}" Offset="0.0" />
        <GradientStop Color="{StaticResource Magenta400}" Offset="0.45" />
        <GradientStop Color="{StaticResource Accent300}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Mixer-meter gradient (bottom→top: cyan→violet→magenta). Kept for parity / future meters. -->
    <LinearGradientBrush x:Key="MixerMeterBrush" StartPoint="0%,100%" EndPoint="0%,0%">
        <GradientStop Color="{StaticResource Accent400}" Offset="0.0" />
        <GradientStop Color="{StaticResource Brand500}" Offset="0.5" />
        <GradientStop Color="{StaticResource Magenta500}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hairline top edge for glass (subtle white sheen). -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Brand logo mark (ported 1:1 from marketing/web/public/favicon.svg — the 5-bar equalizer):
         diagonal violet→magenta→cyan gradient for the bars, and the same gradient at 65% alpha
         for the rounded-square outline. Used by Controls/LogoMark. -->
    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource Brand400}" Offset="0.0" />
        <GradientStop Color="{StaticResource Magenta500}" Offset="0.5" />
        <GradientStop Color="{StaticResource Accent400}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoStrokeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#A69d74ff" Offset="0.0" />
        <GradientStop Color="#A6d946ef" Offset="0.5" />
        <GradientStop Color="#A622d3ee" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============================== Aurora glows ============================= -->
    <!-- Radial glow blobs echoing the hero background (violet / magenta / cyan).
         Centre alphas run DIMMER than the hero (0.20 / 0.16 / 0.12 vs 0.30 / 0.24 / 0.18):
         in the app the blobs sit directly behind transcript text, and the hero-strength glow
         washed out reply contrast. Fades to fully transparent (same RGB, 00 alpha → no grey
         halo) by 70% radius. -->
    <RadialGradientBrush x:Key="AuroraVioletBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Color="#337C3AED" Offset="0.0" />
        <GradientStop Color="#007C3AED" Offset="0.70" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraMagentaBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Color="#29D946EF" Offset="0.0" />
        <GradientStop Color="#00D946EF" Offset="0.70" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraCyanBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Color="#1F06B6D4" Offset="0.0" />
        <GradientStop Color="#0006B6D4" Offset="0.70" />
    </RadialGradientBrush>

    <!-- ============================== Typography =============================== -->
    <!-- Bundled brand fonts (see Assets/Fonts). Variable fonts; weight selected per use.
         Space Grotesk → headings/display; Inter → body. Both fall back to the app default
         (Inter, via .WithInterFont()) if the asset is ever missing. -->
    <FontFamily x:Key="FontDisplay">avares://FruityLink.Ui.Avalonia/Assets/Fonts#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontBody">avares://FruityLink.Ui.Avalonia/Assets/Fonts#Inter</FontFamily>

    <!-- Type scale (applied at use sites; listed here for reference):
         display  32  SemiBold  Space Grotesk  (window title / empty-state headline)
         h        18  SemiBold  Space Grotesk
         body     14  Regular   Inter
         small    13  Regular   Inter
         meta     12  Medium    Inter  (status, toggles)
         mono     11  Regular   monospace (tool calls)
         badge    12  Medium    Inter  tracking +0.1em -->

</ResourceDictionary>
