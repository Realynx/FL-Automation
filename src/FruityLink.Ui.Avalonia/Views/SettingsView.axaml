<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FruityLink.Ui.Avalonia.ViewModels"
             x:Class="FruityLink.Ui.Avalonia.Views.SettingsView"
             x:DataType="vm:ChatViewModel">

    <!-- Bounded, clipped, scrollable settings surface. Inherits the ChatWindow's ChatViewModel. -->
    <Grid RowDefinitions="Auto,*" ClipToBounds="True">

        <!-- ============================ Settings header ============================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceTranslucentBrush}"
                BorderBrush="{StaticResource BorderWhite10Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- back to chat -->
                <Button Classes="icon" Width="34" Height="34"
                        Command="{Binding CloseSettingsCommand}"
                        ToolTip.Tip="Back to chat">
                    <!-- 24×24 Canvas = the icon's design grid; a bare Path would be measured by its
                         tight bounds and the Viewbox would scale the glyph off-centre (right/down). -->
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White"
                                  Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="h" Text="Settings" />
                    <TextBlock Classes="meta" Text="Preferences persist on this machine." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Aurora glow backdrop — same hero blobs as the chat surface + installer, so every
             panel shares one brand language. Background layer only: no input, no layout. -->
        <Panel Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="600" Height="600" Fill="{StaticResource AuroraVioletBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-200,0,0" />
            <Ellipse Width="400" Height="400" Fill="{StaticResource AuroraMagentaBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-90,0" />
            <Ellipse Width="380" Height="380" Fill="{StaticResource AuroraCyanBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-140,0,0,0" />
        </Panel>

        <!-- ============================ Settings body ============================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Padding lives on the CONTENT (as Margin), NOT on the ScrollViewer: Avalonia subtracts a
                 ScrollViewer's vertical Padding from the scrollable extent, which makes the bottom Padding
                 worth of content unreachable. Keeping it as content margin folds it into the extent so the
                 last card + the "Stored at …" line always scroll fully into view. Extra bottom breathing
                 room so the final line never sits flush against the edge. -->
            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Stretch"
                        Margin="16,16,16,32">

                <!-- ============================ Account ============================ -->
                <!-- The user's FL Automate account. The AI runs through our gateway with the account's
                     session token: sign in here (tokens land in the encrypted secret store; the identity
                     shown persists in the agent's settings.json). Signing in/out and saving re-configure
                     the live agent (no FL restart needed). -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="badge" Text="ACCOUNT" />
                        <TextBlock Classes="settingDesc"
                                   Text="Your FL Automate account powers the AI. Sign in once; the session is stored encrypted on this machine." />

                        <!-- ── Signed OUT face: email + password + sign in ── -->
                        <StackPanel Spacing="10" IsVisible="{Binding Account.IsLoggedOut}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="meta" Text="Email" />
                                <TextBox Classes="field"
                                         Watermark="you@example.com"
                                         Text="{Binding Account.Email, Mode=TwoWay}"
                                         IsEnabled="{Binding Account.IsNotBusy}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="meta" Text="Password" />
                                <TextBox Classes="field"
                                         PasswordChar="•"
                                         Watermark="Your account password"
                                         Text="{Binding Account.Password, Mode=TwoWay}"
                                         IsEnabled="{Binding Account.IsNotBusy}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button Classes="pill primary" MinHeight="38" MinWidth="96"
                                        Content="Sign in"
                                        Command="{Binding Account.SignInCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Classes="settingDesc" VerticalAlignment="Center"
                                           Text="No account yet?" />
                                <Button Classes="link"
                                        Content="Create one at fl-automate.com ↗"
                                        Command="{Binding Account.OpenAccountPageCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Signed IN face: identity + model picker ── -->
                        <StackPanel Spacing="10" IsVisible="{Binding Account.IsLoggedIn}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="settingLabel"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding Account.SignedInText}" />
                                <Button Grid.Column="1" Classes="pill secondary" MinHeight="32" MinWidth="90"
                                        VerticalAlignment="Center"
                                        Content="Sign out"
                                        Command="{Binding Account.SignOutCommand}" />
                            </Grid>

                            <!-- Jump to the marketing site to upgrade/downgrade/manage billing. -->
                            <Button Classes="link"
                                    Content="Manage subscription at fl-automate.com ↗"
                                    Command="{Binding Account.OpenAccountPageCommand}" />

                            <!-- Model: the account's available models, fetched from the gateway.
                                 First entry is always "Auto (plan default)". -->
                            <StackPanel Spacing="4">
                                <TextBlock Classes="meta" Text="Model" />
                                <ComboBox Classes="field"
                                          ItemsSource="{Binding Account.ModelOptions}"
                                          SelectedItem="{Binding Account.SelectedModelOption, Mode=TwoWay}"
                                          IsEnabled="{Binding Account.IsNotBusy}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModelOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="settingDesc"
                                           Text="Auto uses your plan's default model." />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button Classes="pill primary" MinHeight="38" MinWidth="96"
                                        Content="Save"
                                        Command="{Binding Account.SaveCommand}" />
                                <Button Classes="pill secondary" MinHeight="38" MinWidth="140"
                                        Content="Test connection"
                                        Command="{Binding Account.TestCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Inline status / validation (both faces) -->
                        <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                   Foreground="{StaticResource Accent300Brush}"
                                   IsVisible="{Binding Account.Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding Account.Status}" />
                    </StackPanel>
                </Border>

                <!-- ============================ Debug ============================ -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="badge" Text="DEBUG" Margin="0,0,0,8" />

                        <!-- Show thoughts -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Show thoughts" />
                                <TextBlock Classes="settingDesc"
                                           Text="Reveal the model's streamed reasoning block on each reply." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowThoughts, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderWhite10Brush}" Margin="0,4" />

                        <!-- Show tool calls -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Show tool calls" />
                                <TextBlock Classes="settingDesc"
                                           Text="Show the FL Studio actions the agent runs as accent chips." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowToolCalls, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderWhite10Brush}" Margin="0,4" />

                        <!-- Share debug data (opt-in remote debugging; default OFF). Persists the
                             instant it's toggled — a privacy switch must never sit unsaved behind
                             a separate Save button. Binds through the ACCOUNT gateway because the
                             flag lives in the agent's settings.json (the uploader reads it there),
                             not in the UI-only ui-settings.json like the two toggles above. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Share debug data" />
                                <TextBlock Classes="settingDesc"
                                           Text="Upload each AI turn's debug log (tool calls, responses, timings) to FL Automate so we can diagnose issues and improve the AI. Off by default." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding Account.ShareDebugData, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ Chat ============================ -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="badge" Text="CHAT" Margin="0,0,0,8" />

                        <!-- Auto-scroll -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Auto-scroll to newest" />
                                <TextBlock Classes="settingDesc"
                                           Text="Keep the transcript pinned to the latest message as replies stream in." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ Community ============================ -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="badge" Text="COMMUNITY" Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="FL Automate Discord" />
                                <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                           Text="Tips, plugin ideas, FruityLink SDK help, and the people making FL Studio do new things." />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill secondary" MinHeight="32" MinWidth="90"
                                    VerticalAlignment="Center"
                                    Content="Join ↗"
                                    Command="{Binding OpenDiscordCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ Climate pledge ============================ -->
                <!-- A slim, green-accented HINT mirroring the marketing site's "Our climate pledge"
                     section (marketing/web/.../Planet.tsx): 1.5% of AI revenue → verified carbon
                     credits. GREEN is NOT in the plugin theme (accents are violet/cyan/magenta), so
                     every green below is a LITERAL hex — no {StaticResource} lookup that could
                     silently fail the whole view to the WPF fallback. Static text only: no bindings
                     (safe under x:DataType) and no animations (both blank/crash the embedded FL host). -->
                <Border CornerRadius="12" Padding="14,12"
                        Background="#1410B981"
                        BorderBrush="#4D34D399"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Leaf glyph = the marketing IconLeaf, stroked emerald like its source SVG
                             (fill:none / stroke:currentColor / round caps). 24×24 Canvas is the icon's
                             design grid so the Viewbox scales the glyph centred — same trick as the
                             back-arrow above. -->
                        <Viewbox Grid.Column="0" Width="18" Height="18"
                                 Margin="0,1,12,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#34D399" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M20 4c-8.5 0-14 4.5-14 11a5 5 0 0 0 5 5c6.5 0 9-5.5 9-16z" />
                                <Path Stroke="#34D399" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M4 20c3-6 7-9.5 12-12" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Climate pledge"
                                       FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="#6EE7B7" />
                            <TextBlock Classes="settingDesc" TextWrapping="Wrap">
                                <Run Text="We donate " />
                                <Run Text="1.5% of AI revenue" Foreground="#34D399" FontWeight="Medium" />
                                <Run Text=" to verified carbon credits — helping offset the compute behind every session." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- storage location -->
                <TextBlock Classes="meta" TextWrapping="Wrap"
                           Text="{Binding SettingsFilePath, StringFormat='Stored at {0}'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
