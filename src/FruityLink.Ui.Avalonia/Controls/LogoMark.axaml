<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FruityLink.Ui.Avalonia.Controls.LogoMark">
    <!-- The FL Automate brand mark: the 5-bar equalizer in a rounded square, ported 1:1 from the
         marketing site's canonical vector (marketing/web/public/favicon.svg / IconLogo in icons.tsx —
         same 32-grid geometry, same #0b0b12 tile, same violet→magenta→cyan diagonal gradient with a
         65%-alpha gradient outline). Native shapes (no SVG dependency) so it stays crisp at any size:
         set Width/Height at the use site and the Viewbox scales the 32-unit design grid. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="32" Height="32">
            <!-- tile: #0b0b12 (Ink900) rounded square + gradient hairline -->
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="30" Height="30"
                       RadiusX="9" RadiusY="9"
                       Fill="#0b0b12"
                       Stroke="{StaticResource LogoStrokeBrush}" StrokeThickness="1" />
            <!-- equalizer bars (centre tallest) -->
            <Rectangle Canvas.Left="7"  Canvas.Top="14" Width="2.6" Height="4"  RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource LogoGradientBrush}" />
            <Rectangle Canvas.Left="11" Canvas.Top="11" Width="2.6" Height="10" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource LogoGradientBrush}" />
            <Rectangle Canvas.Left="15" Canvas.Top="7"  Width="2.6" Height="18" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource LogoGradientBrush}" />
            <Rectangle Canvas.Left="19" Canvas.Top="10" Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource LogoGradientBrush}" />
            <Rectangle Canvas.Left="23" Canvas.Top="13" Width="2.6" Height="6"  RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource LogoGradientBrush}" />
        </Canvas>
    </Viewbox>
</UserControl>
