<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FruityLink.Ui.Avalonia.Controls.ThinkingDots">
    <!-- Animated typing/thinking dots. IMPORTANT: this deliberately does NOT use
         Style.Animations — a continuously-running Avalonia animation CRASHES FL's embedded
         software-rendered host (see the Path.spinner note in ChatWindow.axaml). Instead the
         code-behind steps dot opacities with a DispatcherTimer, which is mechanically the same
         render load as streamed-text updates (already proven stable in the embedded host).
         The timer only runs while the control is attached AND effectively visible. -->
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Border x:Name="Dot1" Width="6" Height="6" CornerRadius="9999" VerticalAlignment="Center"
                Background="{StaticResource Accent400Brush}" />
        <Border x:Name="Dot2" Width="6" Height="6" CornerRadius="9999" VerticalAlignment="Center"
                Background="{StaticResource Brand400Brush}" />
        <Border x:Name="Dot3" Width="6" Height="6" CornerRadius="9999" VerticalAlignment="Center"
                Background="{StaticResource Magenta400Brush}" />
    </StackPanel>
</UserControl>
