<Project Sdk="Microsoft.NET.Sdk">

  <!-- =========================================================================
       FruityLink.Ui.Avalonia — the flagship product's INTERIOR UI (layer 2).

       This is the ONE cross-platform Avalonia (.NET/C# + XAML + Skia) codebase for
       the LLM-driven FL Studio co-pilot chat. It renders itself with Skia so it looks
       identical on every platform and is fully themeable to the marketing HERO.

       This is now a LIBRARY (OutputType=Library): the App / Views / Theme / ViewModels /
       Assets that BOTH heads consume —
         • the thin standalone exe head FruityLink.Ui.Avalonia.Desktop (dev `dotnet run`), and
         • the FL Agent plugin, which hosts this UI IN-PROCESS on its own STA Avalonia thread
           (Hosting/EmbeddedAvaloniaHost) and reparents the window's HWND into FL's native
           host form (layer 1). See Hosting/EmbeddedAvaloniaHost + Hosting/AvaloniaChatView.

       NOTE: Central Package Management is ON solution-wide (Directory.Packages.props),
       but — exactly like FruityLink.Plugins.FlAgent — this project opts OUT and pins its
       Avalonia versions inline, so the shared props file stays untouched.
       ========================================================================= -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>FruityLink.Ui.Avalonia</RootNamespace>
    <AssemblyName>FruityLink.Ui.Avalonia</AssemblyName>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Avalonia niceties -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Latest stable Avalonia 11.x (12.x exists but the brief pins 11.x). -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <!-- Ships an embedded Inter font used as the guaranteed default (belt-and-braces
         fallback in case the bundled Assets/Fonts are ever stripped). -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- Dev-only visual tree inspector (F12). Compiled out of Release. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the brand fonts (Space Grotesk + Inter) as app assets so the product
         matches the marketing hero regardless of what's installed on the machine. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
