<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>FruityLink.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
  </ItemGroup>

  <!-- The plugin "man db": each plugin manual is a markdown file under Manuals\ embedded into this
       assembly, so ManualStore loads them from FruityLink.Agent.dll wherever it deploys (incl. the FL
       Agent plugin publish closure) with no build-and-stage change. Adding a plugin = drop a new
       Manuals\*.md file and rebuild; it is auto-discovered. Logical name: FruityLink.Agent.Manuals.<file>.md -->
  <ItemGroup>
    <EmbeddedResource Include="Manuals\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FruityLink.Core\FruityLink.Core.csproj" />
    <ProjectReference Include="..\FruityLink.Llm\FruityLink.Llm.csproj" />
  </ItemGroup>

  <!-- Expose the internal turn-engine seams (AgentTurnRunner, AgentKernelBuilder, ThinkTagParser,
       ToolSubsetSelector, AutoInvokeIterationFilter, …) to the agent test project only. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FruityLink.Agent.Tests" />
  </ItemGroup>

</Project>
