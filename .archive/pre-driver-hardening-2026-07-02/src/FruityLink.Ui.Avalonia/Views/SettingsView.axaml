<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FruityLink.Ui.Avalonia.ViewModels"
             x:Class="FruityLink.Ui.Avalonia.Views.SettingsView"
             x:DataType="vm:ChatViewModel">

    <!-- Bounded, clipped, scrollable settings surface. Inherits the ChatWindow's ChatViewModel. -->
    <Grid RowDefinitions="Auto,*" ClipToBounds="True">

        <!-- ============================ Settings header ============================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceTranslucentBrush}"
                BorderBrush="{StaticResource BorderWhite10Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- back to chat -->
                <Button Classes="icon" Width="34" Height="34"
                        Command="{Binding CloseSettingsCommand}"
                        ToolTip.Tip="Back to chat">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="White"
                              Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                    </Viewbox>
                </Button>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="h" Text="Settings" />
                    <TextBlock Classes="meta" Text="Preferences persist on this machine." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================ Settings body ============================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Padding lives on the CONTENT (as Margin), NOT on the ScrollViewer: Avalonia subtracts a
                 ScrollViewer's vertical Padding from the scrollable extent, which makes the bottom Padding
                 worth of content unreachable. Keeping it as content margin folds it into the extent so the
                 last card + the "Stored at …" line always scroll fully into view. Extra bottom breathing
                 room so the final line never sits flush against the edge. -->
            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Stretch"
                        Margin="16,16,16,32">

                <!-- ============================ AI connection ============================ -->
                <!-- The AGENT's LLM backend. Unlike the toggles below (UI prefs → ui-settings.json), these
                     persist through the agent's own stores: config → settings.json, API key → encrypted
                     secrets.json (DPAPI). Saving re-configures the live agent (no FL restart needed). -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="badge" Text="AI CONNECTION" />
                        <TextBlock Classes="settingDesc"
                                   Text="Which model drives the agent. Persisted to the agent's config; the API key is stored encrypted." />

                        <!-- Provider -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="meta" Text="Provider" />
                            <ComboBox Classes="field"
                                      ItemsSource="{Binding Backend.Providers}"
                                      SelectedItem="{Binding Backend.SelectedProvider, Mode=TwoWay}"
                                      IsEnabled="{Binding Backend.IsNotBusy}" />
                        </StackPanel>

                        <!-- Endpoint -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="meta" Text="Endpoint (base URL)" />
                            <TextBox Classes="field"
                                     Watermark="http://localhost:11434/v1"
                                     Text="{Binding Backend.Endpoint, Mode=TwoWay}"
                                     IsEnabled="{Binding Backend.IsNotBusy}" />
                        </StackPanel>

                        <!-- Model -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="meta" Text="Model (must support tool calling)" />
                            <TextBox Classes="field"
                                     Watermark="qwen2.5, llama3.1, gpt-4o…"
                                     Text="{Binding Backend.Model, Mode=TwoWay}"
                                     IsEnabled="{Binding Backend.IsNotBusy}" />
                        </StackPanel>

                        <!-- API key (masked; blank keeps the stored key) -->
                        <StackPanel Spacing="4" IsVisible="{Binding Backend.ShowApiKey}">
                            <TextBlock Classes="meta" Text="API key" />
                            <TextBox Classes="field"
                                     PasswordChar="•"
                                     Watermark="{Binding Backend.ApiKeyWatermark}"
                                     Text="{Binding Backend.NewApiKey, Mode=TwoWay}"
                                     IsEnabled="{Binding Backend.IsNotBusy}" />
                        </StackPanel>

                        <!-- Azure deployment (Azure only) -->
                        <StackPanel Spacing="4" IsVisible="{Binding Backend.ShowDeployment}">
                            <TextBlock Classes="meta" Text="Azure deployment name" />
                            <TextBox Classes="field"
                                     Text="{Binding Backend.Deployment, Mode=TwoWay}"
                                     IsEnabled="{Binding Backend.IsNotBusy}" />
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Classes="pill primary" MinHeight="38" MinWidth="96"
                                    Content="Save"
                                    Command="{Binding Backend.SaveCommand}" />
                            <Button Classes="pill secondary" MinHeight="38" MinWidth="140"
                                    Content="Test connection"
                                    Command="{Binding Backend.TestCommand}" />
                        </StackPanel>

                        <!-- Inline status / validation -->
                        <TextBlock Classes="settingDesc"
                                   Foreground="{StaticResource Accent300Brush}"
                                   IsVisible="{Binding Backend.Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding Backend.Status}" />
                    </StackPanel>
                </Border>

                <!-- ============================ Debug ============================ -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="badge" Text="DEBUG" Margin="0,0,0,8" />

                        <!-- Show thoughts -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Show thoughts" />
                                <TextBlock Classes="settingDesc"
                                           Text="Reveal the model's streamed reasoning block on each reply." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowThoughts, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderWhite10Brush}" Margin="0,4" />

                        <!-- Show tool calls -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Show tool calls" />
                                <TextBlock Classes="settingDesc"
                                           Text="Show the FL Studio actions the agent runs as accent chips." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowToolCalls, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ Chat ============================ -->
                <Border Classes="card" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="badge" Text="CHAT" Margin="0,0,0,8" />

                        <!-- Auto-scroll -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="settingLabel" Text="Auto-scroll to newest" />
                                <TextBlock Classes="settingDesc"
                                           Text="Keep the transcript pinned to the latest message as replies stream in." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- storage location -->
                <TextBlock Classes="meta" TextWrapping="Wrap"
                           Text="{Binding SettingsFilePath, StringFormat='Stored at {0}'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
