<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>FruityLink.Mcp</RootNamespace>
    <AssemblyName>FruityLink.Mcp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- This project pins its own package versions inline so it builds without the
         shared Directory.Packages.props (central package management). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Open-source MCP server metadata. -->
    <Version>1.0.0</Version>
    <Description>Model Context Protocol (MCP) server exposing the FruityLink FL Studio control SDK as tools.</Description>
  </PropertyGroup>

  <ItemGroup Label="MCP SDK (stdio + DI hosting, plus optional HTTP/SSE transport)">
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

  <!-- HTTP/SSE transport (optional, selected by the http flag) needs the ASP.NET Core shared
       framework. The runtime is already present; this only adds the reference; stdio works regardless. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Label="The FL-control SDK this server exposes">
    <ProjectReference Include="..\FruityLink.Core\FruityLink.Core.csproj" />
    <ProjectReference Include="..\FruityLink.FlStudio\FruityLink.FlStudio.csproj" />
  </ItemGroup>

</Project>
