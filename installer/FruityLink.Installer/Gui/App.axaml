<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FruityLink.Installer.Gui.InstallerApp"
             RequestedThemeVariant="Dark">
    <!-- ============================================================================
         FL Automate installer — hero theme. An installer-local mirror of the shared
         design tokens (docs/ui-design-tokens.md; canonical Avalonia mapping lives in
         src/FruityLink.Ui.Avalonia/Theme/Tokens.axaml). Kept LOCAL — no reference to
         the UI library — so this project still builds standalone in its own folder.
         Only the tokens + control styles the installer actually uses are mirrored.
         ============================================================================ -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- ============ Palette ============ -->
            <Color x:Key="Brand300">#bca5ff</Color>
            <Color x:Key="Brand400">#9d74ff</Color>
            <Color x:Key="Brand500">#8b5cf6</Color>
            <Color x:Key="Brand600">#7c3aed</Color>
            <Color x:Key="Accent300">#67e8f9</Color>
            <Color x:Key="Accent400">#22d3ee</Color>
            <Color x:Key="Magenta400">#e879f9</Color>
            <Color x:Key="Magenta500">#d946ef</Color>
            <Color x:Key="Ink50">#eceef6</Color>
            <Color x:Key="Ink100">#cdcfdd</Color>
            <Color x:Key="Ink200">#a6a8c0</Color>
            <Color x:Key="Ink300">#8a8caa</Color>
            <Color x:Key="Ink600">#232333</Color>
            <Color x:Key="Ink900">#0b0b12</Color>
            <Color x:Key="Ink950">#06060c</Color>

            <SolidColorBrush x:Key="BaseBackgroundBrush" Color="{StaticResource Ink950}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Ink900}" />
            <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="#99000000" />
            <SolidColorBrush x:Key="HeadingTextBrush" Color="White" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="{StaticResource Ink50}" />
            <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource Ink100}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Ink200}" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="{StaticResource Ink300}" />
            <SolidColorBrush x:Key="Accent300Brush" Color="{StaticResource Accent300}" />
            <SolidColorBrush x:Key="Glass04Brush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="Glass05Brush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="Glass08Brush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BorderWhite10Brush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderWhite20Brush" Color="#33FFFFFF" />

            <!-- Status colours: success rides the brand cyan, danger matches the flagship's soft
                 red, warn is the one out-of-palette amber (no warn token exists in the system). -->
            <SolidColorBrush x:Key="OkBrush" Color="{StaticResource Accent300}" />
            <SolidColorBrush x:Key="DangerBrush" Color="#f28b82" />
            <SolidColorBrush x:Key="WarnBrush" Color="#fbbf24" />

            <!-- ============ Gradients (hero) ============ -->
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,36%">
                <GradientStop Color="{StaticResource Brand500}" Offset="0.0" />
                <GradientStop Color="{StaticResource Brand600}" Offset="0.42" />
                <GradientStop Color="{StaticResource Magenta500}" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeadlineGradientBrush" StartPoint="0%,0%" EndPoint="100%,25%">
                <GradientStop Color="{StaticResource Brand300}" Offset="0.0" />
                <GradientStop Color="{StaticResource Magenta400}" Offset="0.45" />
                <GradientStop Color="{StaticResource Accent300}" Offset="1.0" />
            </LinearGradientBrush>

            <!-- ============ Aurora glows (radial, fade to 00-alpha of same RGB) ============ -->
            <RadialGradientBrush x:Key="AuroraVioletBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#4D7C3AED" Offset="0.0" />
                <GradientStop Color="#007C3AED" Offset="0.70" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraMagentaBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#3DD946EF" Offset="0.0" />
                <GradientStop Color="#00D946EF" Offset="0.70" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="AuroraCyanBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#2E06B6D4" Offset="0.0" />
                <GradientStop Color="#0006B6D4" Offset="0.70" />
            </RadialGradientBrush>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="FontDisplay">avares://FruityLink.Installer/Assets/Fonts#Space Grotesk</FontFamily>
            <FontFamily x:Key="FontBody">avares://FruityLink.Installer/Assets/Fonts#Inter</FontFamily>
            <FontFamily x:Key="FontMono">Cascadia Mono,Consolas,monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ============ Base text ============ -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        </Style>
        <Style Selector="TextBlock.h">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="Foreground" Value="{StaticResource HeadingTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="-0.6" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <!-- ============ Buttons: pill base + primary/secondary (mirrors flagship) ============ -->
        <Style Selector="Button.pill">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
        <Style Selector="Button.pill:pressed">
            <Setter Property="RenderTransform" Value="translateY(0)" />
        </Style>
        <Style Selector="Button.pill:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Primary: brand gradient + violet glow. -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BoxShadow" Value="0 10 40 -12 #CC7C3AED" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BoxShadow" Value="0 14 46 -10 #E67C3AED" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BoxShadow" Value="0 8 30 -14 #CC7C3AED" />
        </Style>

        <!-- Secondary: glass. -->
        <Style Selector="Button.secondary">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        </Style>
        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Glass04Brush}" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
        </Style>

        <!-- Caption buttons (custom chrome: minimize / close). -->
        <Style Selector="Button.caption">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CCD946EF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ============ Text field: dark glass ============ -->
        <Style Selector="TextBox.field">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent300Brush}" />
            <Setter Property="SelectionBrush" Value="#668b5cf6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Glass05Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderWhite10Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Glass08Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderWhite20Brush}" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Glass05Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent300Brush}" />
        </Style>

        <!-- ============ Log well: transparent mono text box ============ -->
        <Style Selector="TextBox.log">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="TextBox.log /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement,
                         TextBox.log:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- ============ CheckBox / ProgressBar / Expander accents ============ -->
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="Background" Value="{StaticResource Glass05Brush}" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        </Style>
    </Application.Styles>
</Application>
