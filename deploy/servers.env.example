# =============================================================================
# FL Automate — three-server one-click deploy configuration
#
#   cp servers.env.example servers.env      # then fill in and NEVER commit it
#   bash install-all.sh                     # deploys db + site + gateway
#
# The script connects over SSH (key auth only), copies the build bundles with
# scp, and installs/updates everything remotely. Safe to re-run: every step is
# idempotent, and existing .env files / databases on the servers are preserved.
# =============================================================================

# --- SSH ---------------------------------------------------------------------
# Private key used for ALL servers (per-server users below). The remote user
# must be root or have passwordless sudo (Proxmox VMs/CTs: root is typical).
SSH_KEY="$HOME/.ssh/id_ed25519"

# user@host per server — the address you SSH to from this machine.
DB_SSH="root@10.0.0.10"
WEB_SSH="root@10.0.0.11"
GW_SSH="root@10.0.0.12"
ADMIN_SSH="root@10.0.0.13"    # Ops Console (VPN-only admin box)

# --- Private network (how the servers see each other) -------------------------
# The address the app servers use to reach Postgres, and the addresses Postgres
# allows in pg_hba.conf. On a flat Proxmox bridge these usually equal the SSH
# hosts above — but they can differ (e.g. a dedicated storage/db VLAN).
DB_PRIVATE_IP="10.0.0.10"
WEB_PRIVATE_IP="10.0.0.11"
GW_PRIVATE_IP="10.0.0.12"
ADMIN_PRIVATE_IP="10.0.0.13"

# Optional: a CIDR (e.g. your flat LAN/VPN range "10.0.0.0/16") that may also
# reach Postgres with the app credentials — lets dev machines and ad-hoc tools
# connect directly. Empty = only the app servers above are allowed.
DB_LAN_ACCESS_CIDR=""

# --- Ops Console (Server D — VPN-only, NEVER expose) ---------------------------
# Seed login for the console's own account system (independent of marketing
# accounts). Used only when creating a fresh /opt/fl-console/.env; an existing
# .env on the server is never touched. Recovery: set ADMIN_SEED_RESET=1 in the
# server's .env and restart once.
ADMIN_SEED_EMAIL="you@example.com"
ADMIN_SEED_PASSWORD="CHANGE-ME-ADMIN"

# Domain for the console's self-signed TLS cert (CN/SAN) — match your internal
# DNS name for the box. Empty = "fl-console". To reissue after changing it:
# delete /opt/fl-console/tls on the server and redeploy the admin step.
ADMIN_DOMAIN=""

# --- Database passwords -------------------------------------------------------
# URL-safe characters only (letters, digits, - _ .); they are embedded into
# postgresql:// URLs and SQL statements verbatim.
DB_SITE_PASSWORD="CHANGE-ME-SITE"
DB_GATEWAY_PASSWORD="CHANGE-ME-GATEWAY"

# --- Site ---------------------------------------------------------------------
# Public URL of the marketing site (used in verification-email links).
APP_WEB_URL="https://fl-automate.com"

# Static beta key; empty disables beta redemption. Written to the site's .env
# as BETA_ACCESS_KEY on first install (or appended later if the line is
# missing — an existing value on the server is never overwritten).
SITE_BETA_ACCESS_KEY=""

# The Windows desktop-app installer is restaged (bootstrap/build-and-stage.ps1
# -Production: native DLLs + Avalonia plugin closure), packaged
# (installer/package.ps1), and uploaded as part of the site step: the newest
# installer/artifacts/fl-automate-installer-v*.zip lands on Server B as
# /opt/fl-automate/downloads/fl-automate-installer.zip — the stable name the
# marketing API serves. Stage/packaging failure only skips or degrades the
# upload (warning); the site deploy itself never fails over it.

# Public hostname you give the AI gateway in the Cloudflare dashboard. Only
# used for the network summary the script prints at the end.
GATEWAY_PUBLIC_HOST="ai.fl-automate.com"

# --- Gateway (optional) --------------------------------------------------------
# (The gateway has NO /admin endpoints — admin tooling is the VPN-only Ops Console.)
# Legacy single-upstream fallback for plans with no config of their own.
# Providers: openai | anthropic | ollama | mock | none. "none" (or empty)
# means EXPLICITLY UNCONFIGURED: chat on a fallback plan returns a clear 503
# "no backend configured" instead of silent mock replies. Set "mock" only for
# dev/testing.
GATEWAY_UPSTREAM_PROVIDER="none"
GATEWAY_UPSTREAM_BASE_URL=""
GATEWAY_UPSTREAM_API_KEY=""

# --- Gateway named backends (optional, reusable) ---------------------------------
# Define upstreams once, reference them from any plan's model list via
# `@NAME`. Any UPPERCASE name works. `ollama` needs no API key.
#   GATEWAY_BACKEND_<NAME>_PROVIDER   openai | anthropic | ollama | mock
#   GATEWAY_BACKEND_<NAME>_BASE_URL   provider API base URL
#   GATEWAY_BACKEND_<NAME>_API_KEY    provider secret key (server-side only)
# Example:
#   GATEWAY_BACKEND_OPENAI_PROVIDER="openai"
#   GATEWAY_BACKEND_OPENAI_BASE_URL="https://api.openai.com/v1"
#   GATEWAY_BACKEND_OPENAI_API_KEY="sk-..."
#   GATEWAY_BACKEND_LOCAL_PROVIDER="ollama"
#   GATEWAY_BACKEND_LOCAL_BASE_URL="http://10.0.3.60:11434/v1"

# --- Gateway embeddings backend (RAG manual search, optional) --------------------
# Powers POST /v1/embeddings (auth+quota+metered like chat, prompt tokens only).
# Azure OpenAI text-embedding-3-large via the OpenAI-compatible /openai/v1 endpoint
# (API key sent as a Bearer token). Priced by GATEWAY_BACKEND_<NAME>_COST above.
#   GATEWAY_BACKEND_AZURE_EMBED_PROVIDER="openai"
#   GATEWAY_BACKEND_AZURE_EMBED_BASE_URL="https://<resource>.services.ai.azure.com/openai/v1"
#   GATEWAY_BACKEND_AZURE_EMBED_API_KEY="<azure-key>"
#   GATEWAY_BACKEND_AZURE_EMBED_COST="0.13"
# Then point each tier at it (fixed per tier; users cannot choose it) — see the
# GATEWAY_PLAN_<PLAN>_EMBEDDING_MODEL lines in the per-plan section below.

# --- Gateway per-plan routing (optional) ----------------------------------------
# Route each subscription plan (FREE, BETA, PRO, STUDIO) independently.
# PREFERRED: GATEWAY_PLAN_<PLAN>_MODELS — a CSV of pseudonymized models:
#   pseudonym[=upstreamModel[@BACKEND_NAME][=Display Label]]
# The FIRST entry is the plan's default. Clients only ever see the pseudonym +
# label (never the upstream model or backend). '@BACKEND_NAME' binds the model
# to a GATEWAY_BACKEND_<NAME>_* block; without it the plan's own
# PROVIDER/BASE_URL/API_KEY (below) or the legacy fallback is used.
#
# Per-plan single-upstream vars (used when _MODELS entries have no @BACKEND):
#   GATEWAY_PLAN_<PLAN>_PROVIDER        openai | anthropic | ollama | mock | none
#   GATEWAY_PLAN_<PLAN>_BASE_URL        provider API base URL
#   GATEWAY_PLAN_<PLAN>_API_KEY         provider secret key (server-side only)
#   GATEWAY_PLAN_<PLAN>_MODEL           legacy default model (superseded by _MODELS)
#   GATEWAY_PLAN_<PLAN>_ALLOWED_MODELS  legacy allowlist (superseded by _MODELS)
#
# A plan with NOTHING set falls back to GATEWAY_UPSTREAM_* above; with that at
# "none", its users get a 503 "no backend configured" chat error.
#
# Deploy semantics: every NON-EMPTY value here (plans + backends + the legacy
# GATEWAY_UPSTREAM_* mapped to UPSTREAM_*) is upserted into the gateway's
# /opt/ai-gateway/.env on each run (existing line replaced, else appended);
# empty values never touch the server-side .env.
#
# Example (PRO picks between two OpenAI models and a local Ollama model;
# STUDIO gets Anthropic; FREE/BETA stay unconfigured -> 503):
#   GATEWAY_PLAN_PRO_MODELS="quick=gpt-4o-mini@OPENAI=Quick Sketch,deep=gpt-4o@OPENAI=Deep Mix,local=qwen2.5:14b@LOCAL=Local Brain"
#   GATEWAY_PLAN_STUDIO_PROVIDER="anthropic"
#   GATEWAY_PLAN_STUDIO_BASE_URL="https://api.anthropic.com"
#   GATEWAY_PLAN_STUDIO_API_KEY="sk-ant-..."
#   GATEWAY_PLAN_STUDIO_MODELS="genius=claude-sonnet-4-20250514=Genius,swift=claude-3-5-haiku-20241022=Swift"
GATEWAY_PLAN_FREE_PROVIDER=""
GATEWAY_PLAN_FREE_BASE_URL=""
GATEWAY_PLAN_FREE_API_KEY=""
GATEWAY_PLAN_FREE_MODEL=""
GATEWAY_PLAN_FREE_ALLOWED_MODELS=""
GATEWAY_PLAN_FREE_MODELS=""
GATEWAY_PLAN_BETA_PROVIDER=""
GATEWAY_PLAN_BETA_BASE_URL=""
GATEWAY_PLAN_BETA_API_KEY=""
GATEWAY_PLAN_BETA_MODEL=""
GATEWAY_PLAN_BETA_ALLOWED_MODELS=""
GATEWAY_PLAN_BETA_MODELS=""
GATEWAY_PLAN_PRO_PROVIDER=""
GATEWAY_PLAN_PRO_BASE_URL=""
GATEWAY_PLAN_PRO_API_KEY=""
GATEWAY_PLAN_PRO_MODEL=""
GATEWAY_PLAN_PRO_ALLOWED_MODELS=""
GATEWAY_PLAN_PRO_MODELS=""
GATEWAY_PLAN_STUDIO_PROVIDER=""
GATEWAY_PLAN_STUDIO_BASE_URL=""
GATEWAY_PLAN_STUDIO_API_KEY=""
GATEWAY_PLAN_STUDIO_MODEL=""
GATEWAY_PLAN_STUDIO_ALLOWED_MODELS=""
GATEWAY_PLAN_STUDIO_MODELS=""
# Fixed embedding model per tier for RAG manual search (search_manual) — not
# client-selectable; keep identical across tiers so it matches the shipped corpus.
GATEWAY_PLAN_BETA_EMBEDDING_MODEL=""
GATEWAY_PLAN_PRO_EMBEDDING_MODEL=""
GATEWAY_PLAN_STUDIO_EMBEDDING_MODEL=""
GATEWAY_PLAN_LABEL_EMBEDDING_MODEL=""    # e.g. "text-embedding-3-large@AZURE_EMBED"

# --- Gateway topic guardrail (optional) ------------------------------------------
# A second, cheap AI model that keeps conversations on-topic (music production
# in FL Studio); off-topic use (programming, hacking, homework, general chat)
# is steered or blocked before it burns main-model tokens. Deploy semantics
# match the plan vars above: NON-EMPTY values are upserted into the gateway's
# .env each run; empty values never touch the server. Full reference:
# ai-gateway/.env.example.
#   GATEWAY_GUARDRAIL_MODE       off | log (evaluate only) | enforce
#   GATEWAY_GUARDRAIL_BACKEND    name of a GATEWAY_BACKEND_<NAME>_* block
#   GATEWAY_GUARDRAIL_MODEL      classifier model id (cheap/fast, e.g. gpt-4o-mini)
# Recommended first week of beta: MODE=log, then flip to enforce.
GATEWAY_GUARDRAIL_MODE=""
GATEWAY_GUARDRAIL_BACKEND=""
GATEWAY_GUARDRAIL_MODEL=""

# --- Gateway chat request logging (optional) --------------------------------------
# Per-user request logs in the gateway database (brotli-compressed payloads,
# auto-expiring). GATEWAY_CHAT_LOG: off | metadata (default) | full — "full"
# stores prompts/completions and needs ToS/privacy coverage. Retention in days.
GATEWAY_CHAT_LOG=""
GATEWAY_CHAT_LOG_RETENTION_DAYS=""

# --- Billing (see docs/billing-spec.md) ------------------------------------------
# Cost in $ per MILLION tokens per backend. For time-billed backends (Ollama) this
# is an arbitrary tunable knob approximating GPU-time cost; for token-billed
# backends use the provider's real prices ("in=X,out=Y" or a single number).
#GATEWAY_BACKEND_OLLAMA_COST="1.00"
#GATEWAY_MODEL_COSTS="OPENAI/gpt-4o=in=2.50,out=10.00;ANTHROPIC/claude-*=in=3.00,out=15.00"
#GATEWAY_COST_FALLBACK="5.00"    # unpriced models are charged at this rate (never free)
# Margin, per-tier budgets, and subscription prices are DB config — edit them live
# on the Ops Console's Pricing page. Tiers: free | pro | studio | label ($100/mo).
